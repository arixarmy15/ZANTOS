# Tickline server configuration.
# Copy to `.env.local` and fill in values. Never commit `.env.local` or any real key.
# All variables are read on the server only; none of them may use the NEXT_PUBLIC_ prefix.

# --- AI providers -------------------------------------------------------------
# Tickline works with Anthropic (default) and with any server that implements the
# OpenAI chat completions API (an LLM gateway, OpenAI, vLLM, Ollama...). Without a
# configured provider the app runs but reading and the AI features are disabled.
# In GitHub Codespaces, store keys as Codespaces secrets instead of in a file.

# Default provider for every AI task: anthropic | openai-compatible
AI_PROVIDER=anthropic

# Anthropic. Model used when a task runs on Anthropic. Default: claude-sonnet-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI-compatible endpoint: base URL up to and including /v1, key (optional for local
# servers) and the default model id. `npm run ai:models` lists the models it offers.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Optional per-task routing: <model> on the default provider, or <provider>:<model>.
# Example: read documents with Claude, compare and draft with a gateway model.
#   AI_EXTRACT_MODEL=anthropic:claude-sonnet-5-5
#   AI_COMPARE_MODEL=openai-compatible:deepseek-v4.1-flash
AI_EXTRACT_MODEL=
AI_COMPARE_MODEL=
AI_EXPLAIN_MODEL=
AI_EMAIL_MODEL=

# --- Storage -------------------------------------------------------------------
# Directory for the SQLite database and uploaded files (git-ignored). Default: ./data
DATA_DIR=./data

# --- Upload limits -----------------------------------------------------------
# Max size per file in MB (1-20). Accepted types: PDF, PNG, JPG (checked by magic bytes).
UPLOAD_MAX_FILE_MB=20
# Max pages per PDF (1-100).
UPLOAD_MAX_PAGES=20
# Max documents in one check (1-20).
UPLOAD_MAX_FILES_PER_CHECK=10

# --- Retention -----------------------------------------------------------------
# Uploaded files and their extracted data are deleted automatically after this many hours (1-720).
RETENTION_HOURS=24

# --- Edition (build time) ---------------------------------------------------------
# hebrew (default): every visitor starts in Hebrew; the other languages are in the menu.
# multilingual: the earlier edition; English by default, starting language from the browser.
TICKLINE_EDITION=hebrew

# Contact address shown on the overview page ("Write to the founder"), e.g. founder@your-domain.
CONTACT_EMAIL=

# Public address of the deployment (e.g. https://tickline.example.com). Enables canonical and
# hreflang links, the sitemap and absolute social preview URLs. Leave empty for local use.
SITE_URL=

{
  "name": "tickline",
  "version": "0.0.0",
  "private": true,
  "description": "Multilingual pre-shipment check for international trade documents (commercial invoice, packing list, purchase order).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test && npm run check:secrets",
    "test:live": "AI_LIVE_TEST=1 node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run test/live",
    "ai:models": "node --env-file-if-exists=.env.local scripts/list-models.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "design:evidence": "node scripts/design/check-evidence.mjs design/evidence/v3/report.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "currency-codes": "^2.2.0",
    "decimal.js": "^10.6.0",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "intl-messageformat": "11.2.15",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }

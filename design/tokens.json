{
  "$description": "TradeCheck design tokens. Source of truth for DESIGN.md and, from Phase 2, the CSS custom properties. Light theme only in the MVP.",
  "color": {
    "named": {
      "ledger": { "value": "#F2F4F3", "role": "App background (cool ledger-paper grey)" },
      "paper": { "value": "#FFFFFF", "role": "Surfaces: document pane, tables, dialogs" },
      "carbon": { "value": "#17212B", "role": "Primary text and icons (blue-black ink)" },
      "slate": { "value": "#55616C", "role": "Secondary text, metadata, placeholder" },
      "rule": { "value": "#D5DCE0", "role": "Hairlines that separate regions and rows" },
      "harbor": {
        "value": "#0E5E6D",
        "role": "Action and linkage: primary buttons, links, focus, selection, evidence marks"
      }
    },
    "derived": {
      "harbor-strong": { "value": "#0A4955", "role": "Harbor hover/pressed" },
      "harbor-tint": { "value": "#E2EEF0", "role": "Selected row, active tab background" },
      "evidence-wash": {
        "value": "#DDE8EB",
        "role": "Evidence highlight in the document (Harbor at 14% on paper)"
      },
      "control-border": {
        "value": "#78838D",
        "role": "Borders of inputs, selects and checkboxes (>= 3:1)"
      },
      "overlay-scrim": { "value": "rgba(23, 33, 43, 0.48)", "role": "Behind dialogs and sheets" }
    },
    "status": {
      "error": {
        "fg": "#B42318",
        "bg": "#FDECEA",
        "border": "#F0B4AE",
        "mark": "#C9372C",
        "icon": "octagon-alert"
      },
      "warning": {
        "fg": "#8A4A00",
        "bg": "#FFF3DB",
        "border": "#EDC678",
        "mark": "#B86E00",
        "icon": "triangle-alert"
      },
      "info": {
        "fg": "#2A5BA8",
        "bg": "#E9F0FB",
        "border": "#B6CAEB",
        "mark": "#3A6CC0",
        "icon": "info"
      },
      "success": {
        "fg": "#1D6B36",
        "bg": "#E6F4EA",
        "border": "#A8D4B4",
        "mark": "#2B8446",
        "icon": "circle-check"
      },
      "unverified": {
        "fg": "#55616C",
        "bg": "#EEF1F3",
        "border": "#78838D",
        "mark": "#7D8891",
        "icon": "circle-help"
      }
    },
    "dataviz": {
      "surface": "#FFFFFF",
      "series1": "#007FA0",
      "categorical": [
        "#007FA0",
        "#EB6834",
        "#1BAF7A",
        "#EDA100",
        "#E87BA4",
        "#008300",
        "#6250D6",
        "#E34948"
      ],
      "gridline": "#E4E8EA",
      "axis": "#B9C1C7"
    }
  },
  "font": {
    "sans": "\"IBM Plex Sans\", \"IBM Plex Sans Arabic\", system-ui, -apple-system, \"Segoe UI\", \"Noto Sans\", sans-serif",
    "arabic": "\"IBM Plex Sans Arabic\", \"IBM Plex Sans\", \"Noto Sans Arabic\", \"Segoe UI\", sans-serif",
    "mono": "\"IBM Plex Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
    "weight": { "regular": 400, "medium": 500, "semibold": 600 }
  },
  "type": {
    "caption": { "size": "12px", "line": "16px", "weight": 400 },
    "small": { "size": "13px", "line": "18px", "weight": 400 },
    "body": { "size": "14px", "line": "20px", "weight": 400 },
    "reading": { "size": "16px", "line": "24px", "weight": 400 },
    "title-sm": { "size": "15px", "line": "20px", "weight": 600 },
    "title": { "size": "18px", "line": "24px", "weight": 600 },
    "heading": { "size": "22px", "line": "28px", "weight": 600 },
    "page": { "size": "28px", "line": "34px", "weight": 600 }
  },
  "space": {
    "0": "0px",
    "0.5": "2px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": { "none": "0px", "xs": "2px", "sm": "4px", "md": "6px" },
  "size": {
    "control-sm": "28px",
    "control-md": "36px",
    "control-lg": "44px",
    "row": "40px",
    "topbar": "48px",
    "hit-min": "24px",
    "hit-fine": "40px",
    "hit-coarse": "44px"
  },
  "shadow": {
    "overlay": "0 1px 2px rgba(23, 33, 43, 0.06), 0 8px 24px rgba(23, 33, 43, 0.12)"
  },
  "motion": {
    "duration": { "instant": "80ms", "fast": "140ms", "normal": "200ms", "slow": "280ms" },
    "easing": {
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "distance": { "xs": "4px", "sm": "8px" },
    "scale": { "press": 0.98, "enter": 0.98 },
    "reducedMotion": { "maxOpacityDuration": "120ms" }
  },
  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" },
  "contrastPairs": [
    { "fg": "color.named.carbon", "bg": "color.named.paper", "min": 4.5 },
    { "fg": "color.named.carbon", "bg": "color.named.ledger", "min": 4.5 },
    { "fg": "color.named.slate", "bg": "color.named.paper", "min": 4.5 },
    { "fg": "color.named.slate", "bg": "color.named.ledger", "min": 4.5 },
    { "fg": "color.named.harbor", "bg": "color.named.paper", "min": 4.5 },
    { "fg": "color.named.harbor", "bg": "color.named.ledger", "min": 4.5 },
    { "fg": "color.named.paper", "bg": "color.named.harbor", "min": 4.5 },
    { "fg": "color.named.paper", "bg": "color.derived.harbor-strong", "min": 4.5 },
    { "fg": "color.named.carbon", "bg": "color.derived.harbor-tint", "min": 4.5 },
    { "fg": "color.named.harbor", "bg": "color.derived.harbor-tint", "min": 4.5 },
    { "fg": "color.named.carbon", "bg": "color.derived.evidence-wash", "min": 4.5 },
    { "fg": "color.named.slate", "bg": "color.derived.evidence-wash", "min": 4.5 },
    { "fg": "color.derived.control-border", "bg": "color.named.paper", "min": 3 },
    { "fg": "color.derived.control-border", "bg": "color.named.ledger", "min": 3 },
    { "fg": "color.named.harbor", "bg": "color.named.paper", "min": 3, "note": "focus ring" },
    { "fg": "color.status.error.fg", "bg": "color.named.paper", "min": 4.5 },
    { "fg": "color.status.error.fg", "bg": "color.status.error.bg", "min": 4.5 },
    { "fg": "color.status.warning.fg", "bg": "color.named.paper", "min": 4.5 },
    { "fg": "color.status.warning.fg", "bg": "color.status.warning.bg", "min": 4.5 },
    { "fg": "color.status.info.fg", "bg": "color.named.paper", "min": 4.5 },
    { "fg": "color.status.info.fg", "bg": "color.status.info.bg", "min": 4.5 },
    { "fg": "color.status.success.fg", "bg": "color.named.paper", "min": 4.5 },
    { "fg": "color.status.success.fg", "bg": "color.status.success.bg", "min": 4.5 },
    { "fg": "color.status.unverified.fg", "bg": "color.named.paper", "min": 4.5 },
    { "fg": "color.status.unverified.fg", "bg": "color.status.unverified.bg", "min": 4.5 },
    { "fg": "color.status.error.mark", "bg": "color.dataviz.surface", "min": 3 },
    { "fg": "color.status.warning.mark", "bg": "color.dataviz.surface", "min": 3 },
    { "fg": "color.status.info.mark", "bg": "color.dataviz.surface", "min": 3 },
    { "fg": "color.status.success.mark", "bg": "color.dataviz.surface", "min": 3 },
    { "fg": "color.status.unverified.mark", "bg": "color.dataviz.surface", "min": 3 },
    { "fg": "color.dataviz.series1", "bg": "color.dataviz.surface", "min": 3 }
  ]
}

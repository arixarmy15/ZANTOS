{
  "$description": "Tickline design tokens (\"Deep water and signal\", October 2026). Source of truth for DESIGN.md and the CSS custom properties. Light theme with deep-water bands.",
  "color": {
    "named": {
      "ledger": {
        "value": "#EEF2F6",
        "role": "App background (harbour fog)"
      },
      "paper": {
        "value": "#FFFFFF",
        "role": "Surfaces: document pane, tables, dialogs"
      },
      "carbon": {
        "value": "#0E2A47",
        "role": "Primary text and icons (deep-water navy ink)"
      },
      "slate": {
        "value": "#4A5B70",
        "role": "Secondary text, metadata, placeholder"
      },
      "rule": {
        "value": "#D9E1EA",
        "role": "Hairlines that separate regions and rows"
      },
      "harbor": {
        "value": "#0F766E",
        "role": "Action and linkage: primary buttons, links, focus, selection, evidence marks"
      }
    },
    "derived": {
      "harbor-strong": {
        "value": "#115E59",
        "role": "Harbor hover/pressed"
      },
      "harbor-tint": {
        "value": "#E3F4F1",
        "role": "Selected row, active tab background"
      },
      "evidence-wash": {
        "value": "#CFEDE7",
        "role": "Evidence highlight in the document (Harbor at 14% on paper)"
      },
      "control-border": {
        "value": "#7D8A9B",
        "role": "Borders of inputs, selects and checkboxes (>= 3:1)"
      },
      "overlay-scrim": {
        "value": "rgba(14, 42, 71, 0.48)",
        "role": "Behind dialogs and sheets"
      }
    },
    "status": {
      "error": {
        "fg": "#B42318",
        "bg": "#FDECEA",
        "border": "#F0B4AE",
        "mark": "#C9372C",
        "icon": "octagon-alert"
      },
      "warning": {
        "fg": "#8A4A00",
        "bg": "#FFF3DB",
        "border": "#EDC678",
        "mark": "#B86E00",
        "icon": "triangle-alert"
      },
      "info": {
        "fg": "#2A5BA8",
        "bg": "#E9F0FB",
        "border": "#B6CAEB",
        "mark": "#3A6CC0",
        "icon": "info"
      },
      "success": {
        "fg": "#1D6B36",
        "bg": "#E6F4EA",
        "border": "#A8D4B4",
        "mark": "#2B8446",
        "icon": "circle-check"
      },
      "unverified": {
        "fg": "#55616C",
        "bg": "#EEF1F3",
        "border": "#78838D",
        "mark": "#7D8891",
        "icon": "circle-help"
      }
    },
    "dataviz": {
      "surface": "#FFFFFF",
      "series1": "#007FA0",
      "categorical": [
        "#007FA0",
        "#EB6834",
        "#1BAF7A",
        "#EDA100",
        "#E87BA4",
        "#008300",
        "#6250D6",
        "#E34948"
      ],
      "gridline": "#E4E8EA",
      "axis": "#B9C1C7"
    },
    "deep": {
      "deep": {
        "value": "#0E2A47",
        "role": "Deep-water bands: overview hero and call to action"
      },
      "deep-raised": {
        "value": "#16365A",
        "role": "Raised controls on deep water"
      },
      "deep-rule": {
        "value": "#2A4A70",
        "role": "Hairlines and chart grid on deep water"
      },
      "on-deep": {
        "value": "#EAF1F8",
        "role": "Text on deep water"
      },
      "on-deep-muted": {
        "value": "#A9BBD0",
        "role": "Secondary text on deep water"
      },
      "glow": {
        "value": "#5EEAD4",
        "role": "Icons, links and focus ring on deep water; the hero glow"
      },
      "signal": {
        "value": "#FF7A1A",
        "role": "Decorative marks on deep water only; never text on light, never a status"
      }
    }
  },
  "font": {
    "sans": {
      "value": "Archivo Variable (wdth 62–125, wght 100–900)",
      "role": "Interface; headings at 112 % width"
    },
    "arabic": {
      "value": "IBM Plex Sans Arabic",
      "role": "Arabic interface text, never stretched or letter-spaced"
    },
    "mono": {
      "value": "Geist Mono",
      "role": "Codes only: HS codes, IBANs, VAT/EORI numbers, references, finding tags"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "type": {
    "caption": {
      "size": "12px",
      "line": "16px",
      "weight": 400
    },
    "small": {
      "size": "13px",
      "line": "18px",
      "weight": 400
    },
    "body": {
      "size": "14px",
      "line": "20px",
      "weight": 400
    },
    "reading": {
      "size": "16px",
      "line": "24px",
      "weight": 400
    },
    "title-sm": {
      "size": "15px",
      "line": "20px",
      "weight": 600
    },
    "title": {
      "size": "18px",
      "line": "24px",
      "weight": 600
    },
    "heading": {
      "size": "22px",
      "line": "28px",
      "weight": 600
    },
    "page": {
      "size": "28px",
      "line": "34px",
      "weight": 600
    }
  },
  "space": {
    "0": "0px",
    "0.5": "2px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "none": "0px",
    "xs": "2px",
    "sm": "4px",
    "md": "6px"
  },
  "size": {
    "control-sm": "28px",
    "control-md": "36px",
    "control-lg": "44px",
    "row": "40px",
    "topbar": "48px",
    "hit-min": "24px",
    "hit-fine": "40px",
    "hit-coarse": "44px"
  },
  "shadow": {
    "overlay": "0 1px 2px rgba(23, 33, 43, 0.06), 0 8px 24px rgba(23, 33, 43, 0.12)"
  },
  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "140ms",
      "normal": "200ms",
      "slow": "280ms"
    },
    "easing": {
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "distance": {
      "xs": "4px",
      "sm": "8px"
    },
    "scale": {
      "press": 0.98,
      "enter": 0.98
    },
    "reducedMotion": {
      "maxOpacityDuration": "120ms"
    }
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "contrastPairs": [
    {
      "fg": "color.named.carbon",
      "bg": "color.named.paper",

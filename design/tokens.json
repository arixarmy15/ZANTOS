{
  "$description": "Tickline design tokens, v3 \"Notebook Tabs\" (October 2026): a shipment file as a binder. Source of truth for DESIGN.md and the CSS custom properties.",
  "color": {
    "named": {
      "ledger": {
        "value": "#ECE8E0",
        "role": "App background (the desk)"
      },
      "paper": {
        "value": "#FFFDF8",
        "role": "Sheets: panels, tables, dialogs, the document pane"
      },
      "carbon": {
        "value": "#23252B",
        "role": "Ink: primary text and icons"
      },
      "slate": {
        "value": "#5A5D66",
        "role": "Secondary text, metadata, placeholder"
      },
      "rule": {
        "value": "#DDD6C8",
        "role": "Hairlines between rows and regions"
      },
      "harbor": {
        "value": "#2B45C4",
        "role": "Cobalt: action and linkage (buttons, links, focus, evidence marks)"
      }
    },
    "derived": {
      "harbor-strong": {
        "value": "#1F339A",
        "role": "Harbor hover/pressed"
      },
      "harbor-tint": {
        "value": "#E7EBFB",
        "role": "Selected row, active tab background"
      },
      "evidence-wash": {
        "value": "#DCE3FB",
        "role": "Evidence highlight in the document (Harbor at 14% on paper)"
      },
      "control-border": {
        "value": "#8A8476",
        "role": "Borders of inputs, selects and checkboxes (>= 3:1)"
      },
      "overlay-scrim": {
        "value": "rgba(35, 37, 43, 0.48)",
        "role": "Behind dialogs and sheets"
      }
    },
    "status": {
      "error": {
        "fg": "#B42318",
        "bg": "#FDECEA",
        "border": "#F0B4AE",
        "mark": "#C9372C",
        "icon": "octagon-alert"
      },
      "warning": {
        "fg": "#8A4A00",
        "bg": "#FFF3DB",
        "border": "#EDC678",
        "mark": "#B86E00",
        "icon": "triangle-alert"
      },
      "info": {
        "fg": "#1D6A84",
        "bg": "#E2F1F6",
        "border": "#A9D3E0",
        "mark": "#2A7F9B",
        "icon": "info"
      },
      "success": {
        "fg": "#1D6B36",
        "bg": "#E6F4EA",
        "border": "#A8D4B4",
        "mark": "#2B8446",
        "icon": "circle-check"
      },
      "unverified": {
        "fg": "#55616C",
        "bg": "#EEF1F3",
        "border": "#78838D",
        "mark": "#7D8891",
        "icon": "circle-help"
      }
    },
    "dataviz": {
      "surface": "#FFFDF8",
      "series1": "#2B45C4",
      "categorical": [
        "#2B45C4",
        "#EB6834",
        "#1BAF7A",
        "#EDA100",
        "#E87BA4",
        "#008300",
        "#6250D6",
        "#E34948"
      ],
      "gridline": "#E4E8EA",
      "axis": "#B9C1C7"
    },
    "deep": {
      "deep": {
        "value": "#23252B",
        "role": "Charcoal bands: overview hero panel and call to action"
      },
      "deep-raised": {
        "value": "#30333B",
        "role": "Raised controls on charcoal"
      },
      "deep-rule": {
        "value": "#464A54",
        "role": "Hairlines on charcoal"
      },
      "on-deep": {
        "value": "#F6F2EA",
        "role": "Text on charcoal"
      },
      "on-deep-muted": {
        "value": "#BDB6A8",
        "role": "Secondary text on charcoal"
      },
      "glow": {
        "value": "#F6E3A1",
        "role": "The single accent on charcoal: icons, links, focus ring"
      }
    },
    "tabs": {
      "invoice": {
        "value": "#F6E3A1",
        "role": "Commercial invoice tab"
      },
      "packing": {
        "value": "#BFE3CF",
        "role": "Packing list tab"
      },
      "order": {
        "value": "#D6CCF2",
        "role": "Purchase order tab"
      },
      "other": {
        "value": "#F3C9C9",
        "role": "Other document tab"
      }
    }
  },
  "font": {
    "sans": {
      "value": "DM Sans Variable (opsz)",
      "role": "Interface and body"
    },
    "arabic": {
      "value": "IBM Plex Sans Arabic",
      "role": "All Arabic text, including titles"
    },
    "mono": {
      "value": "DM Mono",
      "role": "Codes only: HS codes, IBANs, VAT/EORI numbers, references, finding tags"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "display": {
      "value": "Bodoni Moda Variable (opsz)",
      "role": "Page titles and overview section titles, 24 px and up"
    }
  },
  "type": {
    "caption": {
      "size": "12px",
      "line": "16px",
      "weight": 400
    },
    "small": {
      "size": "13px",
      "line": "18px",
      "weight": 400
    },
    "body": {
      "size": "14px",
      "line": "20px",
      "weight": 400
    },
    "reading": {
      "size": "16px",
      "line": "24px",
      "weight": 400
    },
    "title-sm": {
      "size": "15px",
      "line": "20px",
      "weight": 600
    },
    "title": {
      "size": "18px",
      "line": "24px",
      "weight": 600
    },
    "heading": {
      "size": "22px",
      "line": "28px",
      "weight": 600
    },
    "page": {
      "size": "28px",
      "line": "34px",
      "weight": 600
    }
  },
  "space": {
    "0": "0px",
    "0.5": "2px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "none": "0px",
    "xs": "2px",
    "sm": "4px",
    "md": "6px"
  },
  "size": {
    "control-sm": "28px",
    "control-md": "36px",
    "control-lg": "44px",
    "row": "40px",
    "topbar": "48px",
    "hit-min": "24px",
    "hit-fine": "40px",
    "hit-coarse": "44px"
  },
  "shadow": {
    "overlay": "0 1px 2px rgba(23, 33, 43, 0.06), 0 8px 24px rgba(23, 33, 43, 0.12)"
  },
  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "180ms",
      "normal": "350ms",
      "slow": "600ms"
    },
    "easing": {
      "smooth": "cubic-bezier(0.22, 1, 0.36, 1)",
      "sharp": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "stagger": "80ms",
    "press": "scale(0.96)",
    "animate": "transform and opacity only; nothing when reduced motion is requested"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
